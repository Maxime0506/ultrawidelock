diff --git a/applications/matter-ultrawidelock-door-lock-app/src/matter/app_task.cpp b/applications/matter-ultrawidelock-door-lock-app/src/matter/app_task.cpp
index 2529dd5..37c0178 100644
--- a/applications/matter-ultrawidelock-door-lock-app/src/matter/app_task.cpp
+++ b/applications/matter-ultrawidelock-door-lock-app/src/matter/app_task.cpp
@@ -344,6 +344,31 @@ CHIP_ERROR AppTask::Init()
 CHIP_ERROR AppTask::StartApp()
 {
 	ReturnErrorOnFailure(Init());
+
+#ifdef CONFIG_ULTRAWIDELOCK_PRETTY_SHELL
+	/* Curated console runs Matter at WRN, which silences its own SetupQRCode line.
+	 * Re-emit the commissioning QR URL + manual pairing code once here, on module
+	 * `app` (unaffected by MATTER_LOG_LEVEL), so the code is never lost. */
+	{
+		chip::PayloadContents ultrawidelockPayload;
+		if (GetPayloadContents(ultrawidelockPayload, chip::RendezvousInformationFlags(
+							   chip::RendezvousInformationFlag::kBLE)) == CHIP_NO_ERROR) {
+			char ultrawidelockQrBuf[128];
+			char ultrawidelockUrl[256];
+			chip::MutableCharSpan ultrawidelockQr(ultrawidelockQrBuf);
+			if (GetQRCode(ultrawidelockQr, ultrawidelockPayload) == CHIP_NO_ERROR &&
+			    GetQRCodeUrl(ultrawidelockUrl, sizeof(ultrawidelockUrl), ultrawidelockQr) == CHIP_NO_ERROR) {
+				LOG_INF("commis  %s", ultrawidelockUrl);
+			}
+			char ultrawidelockManBuf[64];
+			chip::MutableCharSpan ultrawidelockMan(ultrawidelockManBuf);
+			if (GetManualPairingCode(ultrawidelockMan, ultrawidelockPayload) == CHIP_NO_ERROR) {
+				LOG_INF("commis  manual=%s", ultrawidelockMan.data());
+			}
+		}
+	}
+#endif /* CONFIG_ULTRAWIDELOCK_PRETTY_SHELL */
+
 	VerifyOrReturnError(AliroInit() == EXIT_SUCCESS, CHIP_ERROR_INTERNAL, LOG_ERR("Failed to initialize Aliro"));
 	VerifyOrReturnError(DoorLock::AliroStateControl::UpdateAliroState() == ALIRO_NO_ERROR, CHIP_ERROR_INTERNAL,
 			    LOG_ERR("Failed to update Aliro state"));
