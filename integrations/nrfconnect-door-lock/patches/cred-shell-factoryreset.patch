@@ -25,12 +25,18 @@
 
 #include <app-common/zap-generated/attributes/Accessors.h>
 #include <app/clusters/door-lock-server/door-lock-server.h>
 #include <platform/CHIPDeviceLayer.h>
 #include <setup_payload/OnboardingCodesUtil.h>
 
+#if defined(CONFIG_ULTRAWIDELOCK_CRED) && defined(CONFIG_SHELL)
+#include <app/server/Server.h>
+
+#include "ultrawidelock_shell.h"
+#endif /* CONFIG_ULTRAWIDELOCK_CRED && CONFIG_SHELL */
+
 #include <aliro/aliro.h>
 #include <aliro/aliro_state_control.h>
 #include <aliro/init.h>
 
 #include <zephyr/logging/log.h>
 
@@ -313,12 +319,26 @@ CHIP_ERROR AppTask::Init()
 
 #ifndef CONFIG_CHIP_FACTORY_RESET_ERASE_SETTINGS
 	/* Register application event handler. */
 	ReturnErrorOnFailure(Nrf::Matter::RegisterEventHandler(AppEventHandler, 0));
 #endif /* CONFIG_CHIP_FACTORY_RESET_ERASE_SETTINGS */
 
+#if defined(CONFIG_ULTRAWIDELOCK_CRED) && defined(CONFIG_SHELL)
+	/* Give `ultrawidelock factoryreset yes` the same CHIP entry point the DK's long
+	 * button hold uses (nrf/samples/matter/common/src/board/board.cpp), so the
+	 * console reset and the button reset are the same operation rather than two
+	 * implementations that can drift.
+	 *
+	 * The call is registered from here instead of made from the console because
+	 * the console lives in a pure-C Zephyr module with no CHIP include paths.
+	 * Registering it unconditionally is the point: prj_release.conf turns off
+	 * CONFIG_CHIP_LIB_SHELL, so in a release image `matter device factoryreset`
+	 * does not exist and this is the only console route to a reset. */
+	ultrawidelock_shell_set_factory_reset([] { chip::Server::GetInstance().ScheduleFactoryReset(); });
+#endif /* CONFIG_ULTRAWIDELOCK_CRED && CONFIG_SHELL */
+
 	/* Initialize lock manager */
 	BoltLockMgr().Init(LockStateChanged);
 
 #ifdef CONFIG_DOOR_LOCK_NUS_SERVICE
 	int err = DoorLock::NUSService::Init();
 	VerifyOrReturnError(err == 0, CHIP_ERROR_INTERNAL, LOG_ERR("Failed to initialize NUS service"));
