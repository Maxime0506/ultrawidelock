# ESP32-C6-DevKitC-1 target (applied after sdkconfig.defaults; later wins).
# The official WROOM-1 board has 8 MB flash. The reader does not need the
# Matter app's OTA slots, so keep the compact layout and its large factory app.
CONFIG_IDF_TARGET="esp32c6"
# 160 MHz is the C6's maximum, so this states the ceiling rather than stepping
# down from the 240 the shared defaults ask for (which the C6 has no symbol for).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
