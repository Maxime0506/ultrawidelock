# BLE witness role selection.

mainmenu "ultrawidelock BLE witness"

choice WITNESS_ROLE
	prompt "Witness placement role"
	default WITNESS_ROLE_INSIDE

config WITNESS_ROLE_INSIDE
	bool "Inside the door"

config WITNESS_ROLE_OUTSIDE
	bool "Outside the door"

config WITNESS_ROLE_THRESHOLD
	bool "Threshold / lintel / door frame"

endchoice

source "Kconfig.zephyr"
