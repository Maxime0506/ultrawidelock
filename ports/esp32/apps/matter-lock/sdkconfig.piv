# Disposable-VM PIV/CCID bench profile.
#
# Load this in a separate build directory. Do not merge it into sdkconfig.defaults:
# a native PIV token can be claimed by the host during USB enumeration.
CONFIG_WOZ_PIV_CCID=y
CONFIG_WOZ_PRESENCE=y
CONFIG_TINYUSB_DEBUG_LEVEL=0

# First boot creates the persistent slot-9A certificate in app_main. The
# mbedTLS X.509 writer's call chain exceeds ESP-IDF's default main-task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
