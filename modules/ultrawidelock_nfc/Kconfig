# UltraWideLock NFC transport seam: selects which reader backend implements the UltraWideLockNfc
# transport API consumed by the patched add-on application.

config ULTRAWIDELOCK_NFC
	bool "UltraWideLock NFC transport seam"
	help
	  Compile the UltraWideLockNfc transport seam into the application. The add-on's
	  NFC call sites are patched
	  (integrations/nrfconnect-door-lock/patches/nfc-transport-seam.patch)
	  to go through this seam, so exactly one backend below must be selected
	  in any application build that links those call sites.

if ULTRAWIDELOCK_NFC

choice ULTRAWIDELOCK_NFC_TRANSPORT
	prompt "credential NFC reader transport"
	default ULTRAWIDELOCK_NFC_TRANSPORT_RFAL if NFC_DRIVER_STM
	default ULTRAWIDELOCK_NFC_TRANSPORT_NONE

config ULTRAWIDELOCK_NFC_TRANSPORT_RFAL
	bool "ST25R series via the upstream RFAL transport"
	depends on NFC_DRIVER_STM
	help
	  Forward the seam to the add-on's NfcTransportRfal (X-NUCLEO-NFC12A1
	  with ST25R300 on spi1). Upstream behavior, byte for byte.

config ULTRAWIDELOCK_NFC_TRANSPORT_PN532
	bool "NXP PN532 over SPI"
	depends on SPI
	help
	  In-tree PN532 reader transport. Needs a devicetree node compatible
	  "nxp,pn532-spi" (see apps/nrf5340dk-lock/overlays/pn532.overlay, which
	  reuses the spi1 bus the ST25R shield would occupy). Emits Apple ECP frames
	  while polling so an iPhone auto-presents its credential pass, mirroring the
	  RFAL-path emitter in src/nfc_prop_ecp.cpp.

config ULTRAWIDELOCK_NFC_TRANSPORT_NONE
	bool "No NFC reader fitted"
	help
	  The board has no NFC frontend. Start() succeeds without doing
	  anything; the credential NFC flow is simply never entered. BLE/UWB and
	  Matter operate normally.

endchoice

if ULTRAWIDELOCK_NFC_TRANSPORT_PN532

config ULTRAWIDELOCK_NFC_PN532_THREAD_STACK_SIZE
	int "PN532 transport thread stack size"
	default 3072

config ULTRAWIDELOCK_NFC_PN532_POLL_PERIOD_MS
	int "Polling period between discovery rounds (ms)"
	default 96
	help
	  Delay with the RF field off between polling rounds. Each round emits
	  one ECP frame and one 106 kbps type A activation attempt.

config ULTRAWIDELOCK_NFC_PN532_EXCHANGE_TIMEOUT_MS
	int "APDU exchange response timeout (ms)"
	default 5000
	help
	  Upper bound on one InDataExchange round trip. The PN532 services
	  ISO-DEP WTX requests autonomously, and a User Device performing user
	  authentication can legitimately stretch a response several seconds.

endif # ULTRAWIDELOCK_NFC_TRANSPORT_PN532

module = ULTRAWIDELOCK_NFC
module-str = ultrawidelock_nfc
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endif # ULTRAWIDELOCK_NFC
