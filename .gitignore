# Fetched west workspace (~6.5 GB: NCS + add-on) — reproduced by bootstrap.sh.
# In a git worktree this may be a symlink to the main checkout's workspace, so
# ignore both the directory and the symlink form.
workspace/
/workspace

# Rendered documentation site — regenerate with `make docs`, never commit.
/site/

# Machine-local hooks (doc generation), kept out of tree. See docs.sh.
/tools/*.local

# Python bytecode from the docs helpers
__pycache__/

# Local virtualenv holding the host suites' python deps (markdown, coverage).
# Created by `make tools-install`; the runners resolve it themselves ($PY in
# tests/host/sources.sh), so it is never activated and never on PATH.
.venv/

# Build output. One root for the whole repo: every producer writes its own
# subdirectory under ./build (cdk-matter, nrf5340dk, esp32-<app>-<target>,
# host, _sig …), so `make clean` is a single rm and nothing is left behind.
# The unanchored form stays because calling idf.py directly inside an ESP app
# bypasses the shared root and writes that app's own build/.
/build/
build/
twister-out/
.west/

# Local bench config / secrets — J-Link serials, iPhone UDIDs, shell TTY.
# Commit bench.env.example only.
bench.env

# Local merged firmware for bench-testing the browser flasher; the published
# copy comes from CI (release.yml) via tools/docs_flash.py.
/web-flasher/openaliro-matter-lock-esp32s3.bin
/web-flasher/openaliro-matter-lock-esp32c5.bin

# Python build artifacts from an editable install of the HA agent
*.egg-info/

# macOS
.DS_Store

# claude
CLAUDE.md
.claude/
.worktreeinclude

# internal working notes / plans (not part of the project)
internal/

# BLE/UWB captures: they carry personal Bluetooth data (paired device names,
# nearby IDs, notification metadata) and must never be committed. Keep the
# dissector's real-capture testing (tools/aliro.lua) out of the repo.
*.pcap
*.pcapng
*.pklg
*.btsnoop
btsnoop_hci.log

# scratchpad
scratchpad/

# video generation
video/
