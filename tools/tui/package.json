{
  "name": "@openaliro/bench-tui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --preload ./node_modules/@opentui/solid/scripts/preload.js --conditions=browser --bun src/main.tsx",
    "test": "bun test --preload ./node_modules/@opentui/solid/scripts/preload.js --conditions=browser",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "release": "bun scripts/build.ts --release"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/qrcode": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@xterm/headless": "6.0.0",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "@babel/core": "^7.29.6"
  }
}
